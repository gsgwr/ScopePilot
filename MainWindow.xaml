<Window x:Class="ScopePilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScopePilot" Height="820" Width="1280" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#165DFF"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F6F8"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#172033"/><SolidColorBrush x:Key="TextSecondary" Color="#5E6C84"/><SolidColorBrush x:Key="Border" Color="#DDE2E8"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#172033"/><SolidColorBrush x:Key="FooterBackground" Color="#FFFFFF"/><SolidColorBrush x:Key="Link" Color="#165DFF"/>
        <SolidColorBrush x:Key="InfoBackground" Color="#EEF4FF"/><SolidColorBrush x:Key="InfoBorder" Color="#BCD2FF"/><SolidColorBrush x:Key="WarningBackground" Color="#FFF7E6"/><SolidColorBrush x:Key="WarningBorder" Color="#F0B429"/>
        <SolidColorBrush x:Key="Success" Color="#18794E"/><SolidColorBrush x:Key="ConsoleBackground" Color="#101827"/><SolidColorBrush x:Key="ConsoleForeground" Color="#D9E2F2"/><SolidColorBrush x:Key="Selection" Color="#D7E6FF"/>
        <SolidColorBrush x:Key="DisabledButtonBackground" Color="#E5E9EF"/><SolidColorBrush x:Key="DisabledButtonForeground" Color="#596579"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="110"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource DisabledButtonForeground}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource DisabledButtonForeground}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Success}"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource DisabledButtonForeground}"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/></Style>
        <Style TargetType="ListBox"><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="IsThreeState" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="CheckBoxBorder" Width="16" Height="16" Margin="0,0,7,0" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CheckMark" Text="✓" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource Primary}"/>
                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="GroupBox"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4,4,0,0" Padding="16,9" Margin="1,0,1,-1">
                    <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Panel.ZIndex" Value="10"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource InfoBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlBackground}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="ScopePilot" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Web診断の事前探索と診断対象候補の整理" Foreground="#BFC9D9" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="状態: " Foreground="#BFC9D9" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,8"><TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondary}"/></Border>
        <TabControl Margin="16">
            <TabItem Header="1  案件設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="保存済み案件"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding SavedProjects}" SelectedItem="{Binding SelectedSavedProject}" DisplayMemberPath="DisplayName" Height="70" ToolTip="保存済みの案件を選択します。"/>
                                <Button Grid.Column="1" Content="案件を開く" Command="{Binding LoadProjectCommand}" Margin="8,3,0,10"/>
                            </Grid></GroupBox>
                            <GroupBox Header="基本情報"><StackPanel>
                                <TextBlock Text="案件名"/><TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="開始URL"/><TextBox Text="{Binding Project.StartUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="診断を許可されたOrigin（1行1件）"/><TextBox Text="{Binding Project.AllowedOrigins, UpdateSourceTrigger=PropertyChanged}" Height="86" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="表示・認証に必要だが診断対象外のOrigin"/><TextBox Text="{Binding Project.SupportingOrigins, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel></GroupBox>
                            <GroupBox Header="参照するガイドライン"><StackPanel>
                                <TextBlock Text="チェックを外した資料は、候補選定・根拠表示・Codexへのコンテキストに使用しません。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <CheckBox Content="Webアプリケーション脆弱性診断ガイドライン 第1.2版" IsChecked="{Binding Project.Guidelines.WebAppPentestGuidelines, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="OWASP Top 10:2025" IsChecked="{Binding Project.Guidelines.OwaspTop10, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="OWASP ASVS 5.0" IsChecked="{Binding Project.Guidelines.Asvs, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="OWASP WSTG 4.2" IsChecked="{Binding Project.Guidelines.Wstg, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="OWASP AISVS 1.0（AI機能がある案件）" IsChecked="{Binding Project.Guidelines.Aisvs, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="OWASP Cloud Native Application Security Top 10" IsChecked="{Binding Project.Guidelines.CloudNativeTop10, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                                <CheckBox Content="デジタル庁 DS-221" IsChecked="{Binding Project.Guidelines.Ds221, Mode=TwoWay}" Click="GuidelineCheckBox_Click" Margin="0,3"/>
                            </StackPanel></GroupBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <GroupBox Header="探索条件"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="最大ページ数"/><TextBox Grid.Column="1" Text="{Binding Project.MaxPages}"/>
                                <TextBlock Grid.Row="1" Text="最大実行時間（分）"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Project.MaxMinutes}"/>
                                <TextBlock Grid.Row="2" Text="最大通信数"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Project.MaxRequests}"/>
                            </Grid></GroupBox>
                            <GroupBox Header="アカウントと操作制限"><StackPanel>
                                <TextBlock Text="認証ロール（1行1件）"/><TextBox Text="{Binding Project.Roles, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True"/>
                                <TextBlock Text="自動実行しない操作（1行1件）"/><TextBox Text="{Binding Project.ForbiddenActions, UpdateSourceTrigger=PropertyChanged}" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel></GroupBox>
                            <WrapPanel HorizontalAlignment="Right"><Button Content="新しい案件を開始" Command="{Binding NewProjectCommand}"/><Button Content="環境チェック" Command="{Binding CheckEnvironmentCommand}"/><Button Content="MCPをセットアップ" Command="{Binding SetupMcpCommand}"/><Button Content="案件を保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}"/></WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2  探索コンソール">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" Padding="14" CornerRadius="4"><TextBlock TextWrapping="Wrap" Text="［AI探索を開始］を押すとCodexがPlaywrightで画面を巡回し、Burpで通信を観測します。MFAやCAPTCHAなど人の操作が必要な場合は同じブラウザを開いたまま待機します。"/></Border>
                    <WrapPanel Grid.Row="1" Margin="0,12,0,12"><Button Content="AI探索を開始" Command="{Binding StartExplorationCommand}" Style="{StaticResource PrimaryActionButton}"/><Button Content="探索を停止" Command="{Binding StopExplorationCommand}"/><Button Content="手動操作完了" Command="{Binding ResumeExplorationCommand}" Style="{StaticResource SuccessActionButton}"/><Button Content="探索パッケージのみ生成" Command="{Binding BuildExplorationPackageCommand}"/><Button Content="結果を取り込む" Click="Import_Click"/><Button Content="候補を再生成" Command="{Binding GenerateCandidatesCommand}"/><Button Content="Burp Scope出力" Command="{Binding ExportBurpScopeCommand}"/><Button Content="所見レポート出力" Command="{Binding ExportFindingsCommand}"/><Button Content="ログをすべてコピー" Click="CopyLog_Click"/></WrapPanel>
                    <Border Grid.Row="2" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding InterventionText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding InterventionText}" TextWrapping="Wrap"/>
                    </Border>
                    <GroupBox Grid.Row="3" Header="実行ログ（テキストを選択して Ctrl+C でコピーできます）">
                        <TextBox Text="{Binding ConsoleText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13" Background="{DynamicResource ConsoleBackground}" Foreground="{DynamicResource ConsoleForeground}" Padding="10"
                                 ContextMenuService.ShowOnDisabled="True">
                            <TextBox.ContextMenu>
                                <ContextMenu><MenuItem Header="選択範囲をコピー" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="3  発見した通信">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding RequestSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Project.Requests}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="85"/><DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="75"/><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/><DataGridTextColumn Header="Content-Type" Binding="{Binding ContentType}" Width="180"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="4  診断対象候補">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CandidateSummary}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="採用・除外の記録を解除" Command="{Binding ResetCandidateDecisionsCommand}" Margin="12,0,0,0" ToolTip="この案件で保存した採用・除外の判断をすべて解除し、現在の観測通信から候補を再判定します。"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Project.Candidates}" SelectedItem="{Binding SelectedCandidate}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" CellEditEnding="CandidateGrid_CellEditEnding"><DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="採用" Binding="{Binding Selected}" Width="60"/><DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="85" IsReadOnly="True"/><DataGridTextColumn Header="確信度" Binding="{Binding Confidence}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Method" Binding="{Binding Representative.Method}" Width="75" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="代表URL" Width="2*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Button Content="{Binding Representative.Url}" Tag="{Binding Representative.Url}" Click="CandidateUrl_Click" HorizontalAlignment="Left" Padding="2,0" Margin="0" MinWidth="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Link}" Cursor="Hand" ToolTip="既定のブラウザで開く"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="類似数" Binding="{Binding SimilarCount}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="選定理由" Binding="{Binding Reason}" Width="2*" IsReadOnly="True"/>
                    </DataGrid.Columns></DataGrid>
                    <GroupBox Grid.Row="2" Header="選択した候補の判定シミュレーション" Margin="0,10,0,0" Padding="10">
                        <StackPanel><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedCandidate.DecisionTrace}" TextWrapping="Wrap" FontFamily="Consolas" LineHeight="20"/></ScrollViewer>
                            <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock Text="診断実行時の注意" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCandidate.DiagnosticCaution}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Text="チェックを外した候補は除外キャッシュへ保存し、次回はCodexの確認対象から外します。採用済み候補と新規発見パターンは次回の対象です。候補を再採用するとキャッシュから外れます。［採用・除外の記録を解除］で、この案件の判断を初期化して再判定できます。高速クローラは新規URLを見つけるため次回も巡回します。"/>
                </Grid>
            </TabItem>
            <TabItem Header="5  診断所見">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding FindingSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Project.Findings}" SelectedItem="{Binding SelectedFinding}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"><DataGrid.Columns>
                        <DataGridTextColumn Header="深刻度" Binding="{Binding Severity}" Width="75"/><DataGridTextColumn Header="確信度" Binding="{Binding Confidence}" Width="70"/><DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="対象URL" Binding="{Binding AffectedUrls}" Width="2*"/>
                    </DataGrid.Columns></DataGrid>
                    <GroupBox Grid.Row="2" Header="選択した所見の証跡" Margin="0,10,0,0" Padding="10">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="{Binding SelectedFinding.Description}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="観測根拠" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFinding.Evidence}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,3,0,8"/>
                            <TextBlock Text="対象URL" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFinding.AffectedUrls}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <TextBlock Text="参照基準" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFinding.GuidelineBasis}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <TextBlock Text="制約・未確認事項" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedFinding.Limitations}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel></ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
